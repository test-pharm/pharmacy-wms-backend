{
  "title": "Pharmacy WMS Metrics & Performance",
  "timezone": "browser",
  "panels": [
    {
      "title": "Request Duration",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{
        "expr": "rate(microsoft_aspnetcore_hosting_http_server_request_duration_sum[5m]) / rate(microsoft_aspnetcore_hosting_http_server_request_duration_count[5m])",
        "legendFormat": "avg"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 3}] }
        }
      }
    },
    {
      "title": "Active Requests",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{
        "expr": "microsoft_aspnetcore_hosting_http_server_active_requests",
        "legendFormat": "active"
      }]
    },
    {
      "title": "Request Rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{
        "expr": "rate(microsoft_aspnetcore_hosting_http_server_request_duration_count[1m])",
        "legendFormat": "req/s"
      }],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [{
        "expr": "time() - process_start_time_seconds",
        "legendFormat": "uptime"
      }],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Memory Usage",
      "type": "graph",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 6 },
      "targets": [
        { "expr": "process_working_set_bytes", "legendFormat": "Working Set" },
        { "expr": "dotnet_total_memory_bytes", "legendFormat": "Managed Heap" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "CPU Load",
      "type": "graph",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 6 },
      "targets": [{
        "expr": "rate(process_cpu_seconds_total[1m])",
        "legendFormat": "CPU cores"
      }]
    },
    {
      "title": "DB Connections Pool",
      "type": "graph",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 6 },
      "targets": [{
        "expr": "npgsql_db_client_connections_usage",
        "legendFormat": "{{state}}"
      }]
    },
    {
      "title": "HTTP Response Error Rates",
      "type": "graph",
      "gridPos": { "h": 7, "w": 10, "x": 0, "y": 13 },
      "targets": [
        { "expr": "sum(rate(microsoft_aspnetcore_hosting_http_server_request_duration_count{http_response_status_code=~\"4..\"}[5m]))", "legendFormat": "4xx Client Errors" },
        { "expr": "sum(rate(microsoft_aspnetcore_hosting_http_server_request_duration_count{http_response_status_code=~\"5..\"}[5m]))", "legendFormat": "5xx Server Errors" }
      ]
    },
    {
      "title": "Exceptions Thrown Rate",
      "type": "stat",
      "gridPos": { "h": 7, "w": 7, "x": 10, "y": 13 },
      "targets": [{
        "expr": "rate(dotnet_exceptions_total[1m])",
        "legendFormat": "exceptions/s"
      }],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "Thread Pool Queue",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 7, "x": 17, "y": 13 },
      "targets": [{
        "expr": "dotnet_threadpool_queue_length",
        "legendFormat": "queue length"
      }]
    },
    {
      "title": "Requests per API Route",
      "type": "graph",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 20 },
      "targets": [{
        "expr": "rate(microsoft_aspnetcore_hosting_http_server_request_duration_count[5m])",
        "legendFormat": "{{http_route}}"
      }]
    },
    {
      "title": "HTTP Status Distribution",
      "type": "graph",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 20 },
      "targets": [{
        "expr": "sum(rate(microsoft_aspnetcore_hosting_http_server_request_duration_count[5m])) by (http_response_status_code)",
        "legendFormat": "HTTP {{http_response_status_code}}"
      }]
    },
    {
      "title": ".NET GC Collections Rate",
      "type": "graph",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 27 },
      "targets": [
        { "expr": "rate(dotnet_gc_collections_count_total{generation=\"0\"}[1m])", "legendFormat": "Gen 0 (Short Lived)" },
        { "expr": "rate(dotnet_gc_collections_count_total{generation=\"1\"}[1m])", "legendFormat": "Gen 1 (Intermediate)" },
        { "expr": "rate(dotnet_gc_collections_count_total{generation=\"2\"}[1m])", "legendFormat": "Gen 2 (Full GC)" }
      ]
    }
  ]
}
